---
import Brand from "../components/Brand.astro";
import "../styles.css";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="DentivoHQ keeps dental appointments, patients, schedules, and clinic teams organized."/><title>DentivoHQ — Dental appointment software</title></head><body>
<header class="container header"><Brand/><nav class="nav" aria-label="Main navigation"><a href="#features">Features</a><a href="#workflow">How it works</a><a href="#pricing">Pricing</a><a class="button" href={import.meta.env.PUBLIC_DASHBOARD_URL ?? "http://localhost:5173"}>Start your clinic</a></nav></header>
<main><section class="container hero"><div><h1>A calmer way to run your dental clinic.</h1><p>Appointments, patients, schedules, and your team—organized in one secure workspace.</p><div class="actions"><a class="button" href={import.meta.env.PUBLIC_DASHBOARD_URL ?? "http://localhost:5173"}>Start your clinic</a><a class="button secondary" href="#workflow">See how it works</a></div></div>
<div class="preview" aria-label="DentivoHQ dashboard preview"><div class="preview-head"><Brand/><span>Bright Smiles Clinic</span></div><div class="preview-body"><div class="preview-nav"><span>Overview</span><span>Appointments</span><span>Patients</span><span>Dentists</span><span>Services</span><span>Team</span></div><div class="preview-main"><h2>Today’s appointments</h2><div class="stat-line"><span>9:00 AM · Olivia Bennett</span><span class="status">Confirmed</span></div><div class="stat-line"><span>10:00 AM · James Carter</span><span class="status">Checked in</span></div><div class="stat-line"><span>11:00 AM · Mia Thompson</span><span>Pending</span></div><div class="stat-line"><span>1:00 PM · Ethan Walker</span><span class="status">Confirmed</span></div></div></div></div></section>
<section id="workflow" class="workflow"><div class="container"><h2>A simple workflow for your whole team</h2><p>Everything stays in sync, so nothing falls through the cracks.</p><div class="workflow-grid"><div><strong>1. Schedule</strong><p>Publish availability and receive verified bookings.</p></div><div><strong>2. Manage</strong><p>Keep patients and appointment details organized.</p></div><div><strong>3. Treat</strong><p>Give your care team the schedule context they need.</p></div><div><strong>4. Grow</strong><p>Coordinate locations, staff, and clinic operations.</p></div></div></div></section></main></body></html>
